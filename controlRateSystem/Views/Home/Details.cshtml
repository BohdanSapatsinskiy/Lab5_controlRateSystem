@model controlRateSystem.Data.Models.Currency

@{
    ViewData["Title"] = "Деталі валюти";
}

<div class="container mt-5">
    <h2 class="mb-4">Деталі валюти</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Назва</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Код</dt>
                <dd class="col-sm-8">@Model.Code</dd>

                <dt class="col-sm-4">Ціна в доларах</dt>
                <dd class="col-sm-8">@Model.PriceInDollar</dd>

                <dt class="col-sm-4">Категорія</dt>
                <dd class="col-sm-8">@Model.Category?.Name</dd>
            </dl>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редагувати</a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger me-2">Видалити</a>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
            </div>
        </div>
    </div>
</div>
