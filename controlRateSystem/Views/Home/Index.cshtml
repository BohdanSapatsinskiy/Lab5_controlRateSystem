@model controlRateSystem.Models.ViewModels.RatesListViewModel

<ul class="list-group">
    @foreach (var currency in Model.Currencies)
    {
        <partial name="_CurrencySummary" model="currency" />
    }
</ul>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @if (Model.PagingInfo.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PagingInfo.CurrentPage - 1, selectedCategoryId = Model.SelectedCategoryId })">Попередня</a>
            </li>
        }

        <li class="page-item disabled">
            <span class="page-link">Сторінка @Model.PagingInfo.CurrentPage з @Math.Ceiling((decimal)Model.PagingInfo.TotalItems / Model.PagingInfo.ItemsPerPage)</span>
        </li>

        @if (Model.PagingInfo.CurrentPage < Math.Ceiling((decimal)Model.PagingInfo.TotalItems / Model.PagingInfo.ItemsPerPage))
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PagingInfo.CurrentPage + 1, selectedCategoryId = Model.SelectedCategoryId })">Наступна</a>
            </li>
        }
    </ul>
</nav>


