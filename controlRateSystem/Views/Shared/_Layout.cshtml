<!DOCTYPE html>
<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>controlRateSystem</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">RateSystem</a>

                <div class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="UserProfile">Мій кабінет</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Вийти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        bool showSidebar = currentController != "Account";
    }

    @if (showSidebar)
    {
        <div class="container">
            <div class="row">
                <!-- Сайдбар -->
                <div class="col-md-2">
                    @await Component.InvokeAsync("NavigationMenu")
                </div>

                <div class="col-md-10">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container my-4">
            @RenderBody()
        </div>
    }

    <footer class="bg-light py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0">&copy; 2025 RateSystem.</p>
        </div>
    </footer>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>